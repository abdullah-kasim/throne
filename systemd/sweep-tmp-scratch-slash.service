# sweep-tmp-scratch-slash.service — user unit.
#
# THRONE-OWNED TEMPLATE — not directly loadable by systemd. `{{THRONE_ROOT}}`
# (absolute path of the throne directory) is substituted at install time; only the rendered copy in the
# systemd user unit dir is a working unit. Install with:
#   cd <throne root> && ./bin/throne-cli install-services
#
# No `Wants=`/`After=`: unlike throne-keep-going.service, this run touches
# only the filesystem under /tmp and the live /proc table to check holders —
# it has no herdr/backend dependency to order against or start.

[Unit]
Description=Sweep stale scratch directories under /tmp (one-shot, triggered by sweep-tmp-scratch-slash.timer)

[Service]
Type=oneshot
WorkingDirectory={{THRONE_ROOT}}
ExecStart={{THRONE_ROOT}}/bin/throne-runtime {{THRONE_ROOT}}/dist/src/tools.js sweep-tmp-scratch --apply --tmp-root /tmp
# No ExecStart output redirection needed: systemd captures stdout/stderr to
# the journal by default (journalctl --user -u sweep-tmp-scratch-slash.service).

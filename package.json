{
  "name": "throne",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Agent-agnostic orchestrator: a typed CLI over herdr.",
  "type": "module",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "throne": "bun run build --silent && bun ./dist/src/tools.js",
    "build": "bun scripts/build-and-publish-dist.mjs",
    "build:watch": "nest build --watch",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "bun ./dist/src/tools.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint .",
    "lint:private-refs": "scripts/lint-private-refs.sh",
    "test": "bun scripts/run-suite-container.mjs -- -- bun run test:isolated",
    "test:web": "bun --bun vitest run --config web/vite.config.ts --configLoader runner",
    "test:e2e": "bunx playwright test --config playwright.config.ts",
    "test:heavy": "THRONE_HEAVY_TESTS=1 bun scripts/run-suite-container.mjs -- -- bun test/run-tests.ts",
    "test:slow": "THRONE_SLOW_TESTS=1 bun scripts/run-suite-container.mjs -- -- bun test/run-tests.ts",
    "test:containers": "THRONE_CONTAINER_TESTS=1 bun scripts/run-suite-container.mjs -- -- bun test/run-tests.ts",
    "test:isolated": "bun run lint:private-refs && bun scripts/lint-changed-files.mjs && bun run test:web && bun scripts/run-suite-guarded-tests.mjs --pre-guard bun scripts/herdr-tab-leak-guard.mjs pretest --pre-guard bun scripts/herdr-server-leak-guard.mjs pretest --pre-guard bun scripts/schema-migration-guard.mjs --pre-guard bun scripts/scratch-throne-state-leak-guard.mjs pretest --guard bun scripts/scratch-throne-state-leak-guard.mjs posttest --guard bun scripts/herdr-tab-leak-guard.mjs posttest --guard bun scripts/herdr-server-leak-guard.mjs posttest --guard bun run lint --test bun test/run-tests.ts",
    "test:container": "bun scripts/run-suite-container.mjs",
    "smoke:plan-usage": "bun run throne -- plan-usage-remaining",
    "smoke:codex-usage": "bun run throne -- codex-usage-remaining",
    "smoke:opencode-go-usage": "bun run throne -- opencode-go-usage-remaining"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@typesafe-ai/sdk": "0.6.0",
    "better-sqlite3": "13.1.1",
    "commander": "11.1.0",
    "compression": "1.8.2",
    "drizzle-orm": "0.45.4",
    "magicast": "0.5.5",
    "matrix-bot-sdk": "0.8.0",
    "nest-commander": "3.20.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "semver": "7.8.5",
    "tree-sitter": "0.25.1",
    "tree-sitter-bash": "0.25.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.106.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/inquirer": "8.2.13",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.68.0",
    "nest-commander-testing": "^3.5.1",
    "prettier": "^3.4.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "trustedDependencies": [
    "@matrix-org/matrix-sdk-crypto-nodejs",
    "tree-sitter",
    "tree-sitter-bash"
  ],
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.0"
  }
}

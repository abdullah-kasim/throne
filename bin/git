#!/usr/bin/env bash
set -euo pipefail

guard_marker=throne-git-guard-shim
shim_dir=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
is_a_git_guard_copy() {
    grep -Iqs -e "^guard_marker=$guard_marker\$" -e 'throne git guard' -- "$1"
}

real_git=""
first_unguarded_git=""
IFS=: read -r -a search_path <<<"${PATH:-}"
for path_dir in "${search_path[@]}"; do
    [ -n "$path_dir" ] || path_dir=.
    [ -f "$path_dir/git" ] && [ -x "$path_dir/git" ] || continue
    if [ "$(cd -P "$path_dir" 2>/dev/null && pwd -P)" = "$shim_dir" ]; then
        real_git=""
        continue
    fi
    [ -n "$real_git" ] || real_git="$path_dir/git"
    [ -n "$first_unguarded_git" ] || is_a_git_guard_copy "$path_dir/git" || first_unguarded_git="$path_dir/git"
done
[ -n "$real_git" ] || real_git="$first_unguarded_git"

if [ -z "$real_git" ]; then
    echo "throne git guard: real git binary not found" >&2
    exit 127
fi

next_git_is_another_guard=false
is_a_git_guard_copy "$real_git" && next_git_is_another_guard=true

bypass_requested=false
if [ "${1:-}" = "--bypass" ]; then
    bypass_requested=true
    shift
fi
real_git_prefix=()
if [ "$bypass_requested" = true ] && [ "$next_git_is_another_guard" = true ]; then
    real_git_prefix=(--bypass)
fi

subcommand=""
for ((i = 1; i <= $#; i++)); do
    arg="${!i}"
    case "$arg" in
        -C|--git-dir|--work-tree|--namespace|-c|--config-env|--exec-path)
            ((i++))
            ;;
        --*=*)
            ;;
        -*)
            ;;
        *)
            subcommand="$arg"
            break
            ;;
    esac
done

subcommand_index=$i
case "$subcommand" in
    commit|merge|revert|tag|notes)
        attribution_fence_pattern='co-authored-by:.*(claude|anthropic|copilot|chatgpt|openai|gpt|codex|gemini|cursor)|generated[[:space:]]+with.{0,6}claude|noreply@anthropic\.com'

        text_carries_ai_attribution() {
            local verdict=0
            printf '%s' "$1" | grep -Eiq -- "$attribution_fence_pattern" || verdict=$?
            if [ "$verdict" -gt 1 ]; then
                echo "throne attribution fence: the pattern check itself failed; refusing rather than letting the text through" >&2
                return 0
            fi
            return "$verdict"
        }

        refuse_ai_attribution() {
            local tool="$1"
            local offending_line
            offending_line=$(printf '%s' "$2" | grep -Eio -- "$attribution_fence_pattern" | head -1)
            echo "throne $tool guard: STOP — this text carries an AI attribution line ($offending_line)." >&2
            echo "Commit messages, PR bodies, comments and titles never credit an AI tool: no Co-Authored-By for Claude or any other model, no 'Generated with Claude Code', no noreply@anthropic.com." >&2
            echo "Remove the line and run the command again. There is no bypass for this check." >&2
        }
        fenced_args=("$@")
        fenced_text=""
        read_message_file() {
            local source="$1" position="$2"
            if [ "$source" = - ]; then
                local stdin_copy
                stdin_copy=$(mktemp "${TMPDIR:-/tmp}/throne-git-message.XXXXXX")
                cat >"$stdin_copy"
                fenced_args[$position]="$stdin_copy"
                fenced_text+="$(<"$stdin_copy")"$'\n'
            elif [ -f "$source" ]; then
                fenced_text+="$(<"$source")"$'\n'
            fi
        }
        for ((fence_i = subcommand_index; fence_i < ${#fenced_args[@]}; fence_i++)); do
            fence_arg="${fenced_args[fence_i]}"
            case "$fence_arg" in
                --)
                    break
                    ;;
                -m|--message|--trailer)
                    ((fence_i++))
                    fenced_text+="${fenced_args[fence_i]:-}"$'\n'
                    ;;
                --message=*|--trailer=*)
                    fenced_text+="${fence_arg#*=}"$'\n'
                    ;;
                -F|--file)
                    ((fence_i++))
                    read_message_file "${fenced_args[fence_i]:-}" "$fence_i"
                    ;;
                --file=*)
                    read_message_file "${fence_arg#*=}" "$fence_i"
                    ;;
                --*)
                    ;;
                -*m)
                    ((fence_i++))
                    fenced_text+="${fenced_args[fence_i]:-}"$'\n'
                    ;;
                -*F)
                    ((fence_i++))
                    read_message_file "${fenced_args[fence_i]:-}" "$fence_i"
                    ;;
                -m?*)
                    fenced_text+="${fence_arg#-m}"$'\n'
                    ;;
            esac
        done
        if text_carries_ai_attribution "$fenced_text"; then
            refuse_ai_attribution git "$fenced_text"
            exit 67
        fi
        set -- "${fenced_args[@]}"
        ;;
esac

# Identity guard — before any command that CREATES commits. The court signs
# every commit with the Lord's identity from the live throne config.user.ts
# (`identity.name` / `identity.email`, read through `throne-cli git-identity`
# so nothing here re-parses TypeScript). Without it, git synthesises
# `<user>@<hostname>` — a machine-local address that must never reach a
# repository. That is a STOP: the agent asks the Lord for the values, exactly
# like a missing `gh` login; it never guesses one and never sets a global.
case "$subcommand" in
    commit|merge|cherry-pick|revert|am|rebase)
        identity_args=()
        # The tab's exported identity was chosen for the tab's own origin
        # (THRONE_GIT_IDENTITY_ORIGIN). A commit in a repository with a
        # different origin re-resolves, so an work repo is never signed with
        # the personal identity just because the tab was opened elsewhere.
        env_identity_applies=false
        if [ -n "${GIT_AUTHOR_EMAIL:-}${GIT_COMMITTER_EMAIL:-}" ] && [ -n "${THRONE_GIT_SIGNING_KEY:-}" ]; then
            env_identity_applies=true
            if [ -n "${THRONE_GIT_IDENTITY_ORIGIN:-}" ]; then
                current_origin=$("$real_git" "${@:1:$((i-1))}" remote get-url origin 2>/dev/null || true)
                [ -z "$current_origin" ] || [ "$current_origin" = "$THRONE_GIT_IDENTITY_ORIGIN" ] || env_identity_applies=false
            fi
        fi
        if [ "$env_identity_applies" = false ]; then
            configured=""
            if [ -x "$shim_dir/throne-cli" ]; then
                repo_dir=$("$real_git" "${@:1:$((i-1))}" rev-parse --show-toplevel 2>/dev/null || pwd -P)
                configured=$("$shim_dir/throne-cli" git-identity --repo "$repo_dir" 2>/dev/null) || configured=""
            fi
            IFS=$'\t' read -r cfg_name cfg_email cfg_key cfg_format <<<"$configured"
            if [ -n "$configured" ] && [ -n "${cfg_key:-}" ]; then
                identity_args=(-c "user.name=$cfg_name" -c "user.email=$cfg_email" -c "user.signingkey=$cfg_key" -c commit.gpgsign=true -c tag.gpgsign=true -c "gpg.format=${cfg_format:-openpgp}")
            elif [ -n "$configured" ]; then
                echo "throne git guard: STOP RIGHT THERE — the configured identity has no signing key, and signing is mandatory (Lord, 2026-09-08)." >&2
                echo "Do NOT commit unsigned, do NOT bypass this. Ask the Lord, through your supervisor, to add \`signingKey\` (a gpg key id; or an ssh key path with signingFormat: 'ssh') to the identity in the live throne config.user.ts, then rerun the exact same command." >&2
                exit 66
            else
                effective_email=$("$real_git" "${@:1:$((i-1))}" config --get user.email 2>/dev/null || true)
                effective_name=$("$real_git" "${@:1:$((i-1))}" config --get user.name 2>/dev/null || true)
                host_long=$(hostname 2>/dev/null || true)
                host_short=${host_long%%.*}
                domain=${effective_email#*@}
                local_looking=false
                if [ -z "$effective_email" ] || [ -z "$effective_name" ]; then
                    local_looking=true
                elif [ "$domain" = "$effective_email" ]; then
                    local_looking=true   # no "@" at all
                else
                    case "$domain" in
                        localhost|localdomain|*.local|*.lan|*.home|*.internal|*.localdomain|"(none)") local_looking=true ;;
                    esac
                    [ -n "$host_long" ] && [ "$domain" = "$host_long" ] && local_looking=true
                    [ -n "$host_short" ] && [ "$domain" = "$host_short" ] && local_looking=true
                    case "$domain" in *.*) ;; *) local_looking=true ;; esac
                fi
                if [ "$local_looking" = true ]; then
                    echo "throne git guard: STOP RIGHT THERE — this checkout has no real git identity (name: '${effective_name:-<unset>}', email: '${effective_email:-<unset>}'; git would sign as '${USER:-$(id -un)}@${host_long:-localhost}')." >&2
                    echo "Commits from the court carry the Lord's identity, never a machine-local one. Do NOT guess an identity, do NOT set one globally, do NOT bypass this." >&2
                    echo "Ask the Lord, through your supervisor, to put these two lines into the live throne config.user.ts and then rerun the exact same command:" >&2
                    echo "    identity: { name: '<full name>', email: '<real address>', signingKey: '<gpg key id>' }," >&2
                    echo "(read by \`throne-cli git-identity\`; the shim then signs every commit with it and touches no global config)." >&2
                    exit 66
                fi
            fi
        fi
        if [ ${#identity_args[@]} -gt 0 ]; then
            # A re-resolved identity must beat the tab's stale GIT_* variables:
            # -c user.* is not consulted while GIT_AUTHOR_* is set, so clear them.
            unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
            set -- "${@:1:$((i-1))}" "${identity_args[@]}" "${@:i}"
        elif [ "$env_identity_applies" = true ]; then
            # The tab's own identity: git's env-injected config already carries
            # the key, but say it on the command line too so no repo-level
            # `commit.gpgsign=false` can switch signing off.
            set -- "${@:1:$((i-1))}" -c "user.signingkey=$THRONE_GIT_SIGNING_KEY" -c commit.gpgsign=true -c tag.gpgsign=true -c "gpg.format=${THRONE_GIT_SIGNING_FORMAT:-openpgp}" "${@:i}"
        fi
        ;;
esac

running_in_a_court_session() {
    [ "${THRONE_AGENT_PANE:-}" = 1 ] || [ -n "${THRONE_LIVE_ROOT:-}" ]
}

global_push_check_directory() {
    local configured physical
    configured=$("$real_git" config --global --type=path --get core.hooksPath 2>/dev/null) || return 1
    physical=$(cd -P "$configured" 2>/dev/null && pwd -P) || return 1
    [ -x "$physical/checks-only/pre-push" ] || return 1
    printf '%s\n' "$physical"
}

if [ "$subcommand" = push ]; then
    git_options=("${@:1:$((subcommand_index - 1))}")
    push_arguments=("${@:$((subcommand_index + 1))}")

    effective_hooks_directory() {
        local configured
        configured=$("$real_git" ${git_options[@]+"${git_options[@]}"} rev-parse --path-format=absolute --git-path hooks 2>/dev/null) || return 1
        (cd -P "$configured" 2>/dev/null && pwd -P) || printf '%s\n' "$configured"
    }

    push_checks_are_configured() {
        [ -n "$("$real_git" ${git_options[@]+"${git_options[@]}"} config --get-all push-check.command 2>/dev/null)" ]
    }

    push_remote=""
    push_skips_hooks=false
    next_argument_is_a_value=false
    options_ended=false
    for push_arg in ${push_arguments[@]+"${push_arguments[@]}"}; do
        if [ "$next_argument_is_a_value" = true ]; then
            next_argument_is_a_value=false
            continue
        fi
        if [ "$options_ended" = true ]; then
            [ -n "$push_remote" ] || push_remote="$push_arg"
            continue
        fi
        case "$push_arg" in
            --) options_ended=true ;;
            --no-veri|--no-verif|--no-verify) push_skips_hooks=true ;;
            --veri|--verif|--verify) push_skips_hooks=false ;;
            --repo|--receive-pack|--exec|--push-option|-o) next_argument_is_a_value=true ;;
            -*) ;;
            *) [ -n "$push_remote" ] || push_remote="$push_arg" ;;
        esac
    done
    [ -n "$push_remote" ] || push_remote=origin
    case "$push_remote" in
        /*|file://*|./*|../*) push_remote_is_local=true ;;
        *) push_remote_is_local=false ;;
    esac

    push_check_skip_requested=false
    [ "${PUSH_CHECK_SKIP:-}" = 1 ] && push_check_skip_requested=true
    if [ "$push_remote_is_local" = false ] && running_in_a_court_session && { [ "$push_skips_hooks" = true ] || [ "$push_check_skip_requested" = true ]; }; then
        if [ "$bypass_requested" = true ]; then
            echo "throne git guard: BYPASSED by explicit --bypass: git $*" >&2
        else
            echo "throne git guard: STOP RIGHT THERE — a court session may not skip the push checks (git push --no-verify, or PUSH_CHECK_SKIP=1) when pushing to '$push_remote'." >&2
            echo "The rule: every push runs the checks configured in push-check.command; only the Lord skips them. Push without the skip, fix what the checks report, and push again." >&2
            echo "Only under an order that names this exact push, put --bypass first: git --bypass push ... . If the checks themselves are broken, tell your supervisor; do not route around them." >&2
            exit 68
        fi
    fi

    if [ "$push_remote_is_local" = false ]; then
        push_repo_dir=$("$real_git" "${@:1:$((i-1))}" rev-parse --show-toplevel 2>/dev/null || pwd -P)
        push_agent_name=$(basename "$push_repo_dir")
        throne_data_home="${THRONE_DATA_HOME:-$HOME/.throne}"
        push_ledger="$throne_data_home/data/$push_agent_name"
        case "$push_repo_dir" in
            "$throne_data_home"/worktrees/*) push_from_throne_worktree=true ;;
            *) push_from_throne_worktree=false ;;
        esac
        if [ "$push_from_throne_worktree" = true ] && [ -f "$push_ledger/identity.md" ] && grep -q '^- \*\*Role:\*\* Alpha$' "$push_ledger/identity.md"; then
            conformance_passed=false
            verify_passed=false
            if grep -q '^- \*\*Execution mode:\*\* sliceless (Lord-authorized; implies shadowless)$' "$push_ledger/identity.md"; then
                sliceless_objective_code=$(sed -n 's/^[[:space:]]*"objective_code":[[:space:]]*"\([^"]*\)".*/\1/p' "$push_ledger/spawn.json" 2>/dev/null | head -1 || true)
                sliceless_verify_file="$push_ledger/sliceless/$sliceless_objective_code/verify.md"
                if [ -n "$sliceless_objective_code" ] && [ -f "$sliceless_verify_file" ]; then
                    grep -qs '^\*\*Conformance outcome:\*\* PASS[[:space:]]*$' "$sliceless_verify_file" && conformance_passed=true
                    grep -qs '^\*\*Verify outcome:\*\* PASS[[:space:]]*$' "$sliceless_verify_file" && verify_passed=true
                fi
                if [ "$conformance_passed" != true ] || [ "$verify_passed" != true ]; then
                    if [ -z "$sliceless_objective_code" ]; then
                        gate_state="$push_ledger/spawn.json carries no objective_code, so the verify.md path cannot be resolved"
                    elif [ ! -f "$sliceless_verify_file" ]; then
                        gate_state="$sliceless_verify_file does not exist"
                    elif [ "$conformance_passed" != true ]; then
                        gate_state="$sliceless_verify_file has not recorded '**Conformance outcome:** PASS'"
                    else
                        gate_state="$sliceless_verify_file has not recorded '**Verify outcome:** PASS'"
                    fi
                    echo "throne git guard: STOP RIGHT THERE — $push_agent_name is a sliceless Alpha pushing to '$push_remote' before recording its verification evidence ($gate_state)." >&2
                    echo "A sliceless Alpha delivers only after writing $sliceless_verify_file with its conformance check, its verification record and its delivery note, ending in both '**Conformance outcome:** PASS' and '**Verify outcome:** PASS' on their own lines — see /execute-todos, 'Sliceless mode'. Pushing before that evidence exists is the process deviation AGENTS.md forbids, however small the diff." >&2
                    echo "Do NOT bypass this. Write the evidence, then push. If delivery is genuinely blocked, tell the Regent: throne send-agent Regent <what blocked you>." >&2
                    exit 66
                fi
            else
                latest_bundle=$(ls -d "$push_ledger"/todo-*/ 2>/dev/null | sort | tail -1 || true)
                if [ -n "$latest_bundle" ]; then
                    grep -qs '^\*\*Conformance outcome:\*\* PASS[[:space:]]*$' "$latest_bundle"99a_*.md && conformance_passed=true
                    grep -qs '^\*\*Verify outcome:\*\* PASS[[:space:]]*$' "$latest_bundle"99b_*.md && verify_passed=true
                fi
                if [ "$conformance_passed" != true ] || [ "$verify_passed" != true ]; then
                    if [ -z "$latest_bundle" ]; then
                        gate_state="no todo bundle exists in $push_ledger"
                    elif [ "$conformance_passed" != true ]; then
                        gate_state="99a has not recorded '**Conformance outcome:** PASS' in $latest_bundle"
                    else
                        gate_state="99b has not recorded '**Verify outcome:** PASS' in $latest_bundle"
                    fi
                    echo "throne git guard: STOP RIGHT THERE — $push_agent_name is an Alpha pushing to '$push_remote' before its gate chain passed ($gate_state)." >&2
                    echo "An Alpha delivers only through /write-and-execute-todos: a real Shadow for 99a conformance, a real Shadow for 99b verify-and-fix, then 99c delivers. Writing, testing and pushing the change yourself is the process deviation AGENTS.md forbids, however small the diff." >&2
                    echo "Do NOT bypass this. Run the chain on your current branch, then push. If delivery is genuinely blocked, tell the Regent: throne send-agent Regent <what blocked you>." >&2
                    exit 66
                fi
            fi
            if [ -x "$shim_dir/throne-cli" ]; then
                if ! amendment_report=$(THRONE_DATA_HOME="$throne_data_home" "$shim_dir/throne-cli" check-queue-amendments-reconciled --agent "$push_agent_name" 2>&1); then
                    echo "throne git guard: STOP RIGHT THERE — $push_agent_name is an Alpha pushing to '$push_remote' past a queue amendment its plan has not reconciled." >&2
                    echo "$amendment_report" >&2
                    echo "Do NOT bypass this. Reconcile the amendment into your plan, re-run whichever checks it invalidates, record the reconciled-through line, then push. If delivery is genuinely blocked, tell the Regent: throne send-agent Regent <what blocked you>." >&2
                    exit 66
                fi
            else
                echo "throne git guard: WARNING — $shim_dir/throne-cli is missing, so this push was NOT checked for unreconciled queue amendments." >&2
            fi
        fi
    fi

    if [ "$push_skips_hooks" = false ] && [ "$push_remote_is_local" = false ] && [ "$next_git_is_another_guard" = false ] \
        && push_checks_are_configured && global_dispatcher=$(global_push_check_directory); then
        hooks_directory=$(effective_hooks_directory || true)
        if [ "$hooks_directory" != "$global_dispatcher" ]; then
            echo "throne git guard: this repository's hooks directory (${hooks_directory:-unknown}) hides the global push checks in $global_dispatcher, so they run here first" >&2
            dry_run_status=0
            "$real_git" ${git_options[@]+"${git_options[@]}"} -c "core.hooksPath=$global_dispatcher/checks-only" push --dry-run ${push_arguments[@]+"${push_arguments[@]}"} || dry_run_status=$?
            if [ "$dry_run_status" -ne 0 ]; then
                echo "throne git guard: nothing was pushed — the push checks failed, or the dry run that feeds them their ref lines failed (exit $dry_run_status); see above" >&2
                exit "$dry_run_status"
            fi
        fi
    fi
fi

if [ "$subcommand" != commit ]; then
    exec "$real_git" ${real_git_prefix[@]+"${real_git_prefix[@]}"} "$@"
fi

message=""
args=("$@")
for ((i = 1; i < ${#args[@]}; i++)); do
    case "${args[i]}" in
        -m|--message)
            ((i++))
            message+="${args[i]}\n"
            ;;
        --message=*) message+="${args[i]#*=}\n" ;;
        -F|--file)
            ((i++))
            message+="$(<"${args[i]}")\n"
            ;;
        --file=*) message+="$(<"${args[i]#*=}")\n" ;;
    esac
done

if [[ "$message" =~ (^|[^[:alnum:]])(todo([[:space:]]+skills?)?|Herdr|terminal[[:space:]]+tabs|agents?|Alpha|Shadow|Regent|throne|assignment[[:space:]]+files?|execution[[:space:]]+logs?|slice|gate([[:space:]]+ceremony)?|supervisor|merge[[:space:]]+choreography|campaign|objective|checkpoint|delivery|validator|reap|no-idling|Codex|OpenCode|workflow)[^[:alnum:]] ]]; then
    echo "throne git guard: commit message describes the repository change, not orchestration machinery" >&2
    echo "Use a concise imperative subject with task-domain behavior; remove todo, agent, campaign, gate, or checkpoint provenance." >&2
    exit 65
fi

exec "$real_git" ${real_git_prefix[@]+"${real_git_prefix[@]}"} "$@"

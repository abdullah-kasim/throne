#!/usr/bin/env bash
# claudey — launch Claude Code in yolo mode: skip permission prompts, push a
# checkpoint of the current repo to a local bare backup, and wire skill dirs
# in via --add-dir.
#
# This is the throne's own copy: self-contained under throne/bin, so a throne
# spawn depends on nothing stowed into ~/bin. Needs bash >= 4.3 — the guard
# below re-execs into one or fails with instructions.
#
# Real-binary resolution deliberately never accepts anything inside
# ~/bin-override (see yolo_resolve_real_bin), so a yolo-mode shim planted there
# cannot bounce the launch back through another wrapper.
#
# Honors $CLAUDE_BIN as the real binary override.
#
# All arguments pass through verbatim to the real binary BY DESIGN — no
# interception, so `claudey --help` reaches the real claude's help.

# Bootstrap, inline by necessity: it runs before any sibling file can be
# sourced, so it resolves this script's own directory unaided — through
# symlinks, and without `readlink -f`, which stock macOS does not have.
launcher_source="${BASH_SOURCE[0]}"
launcher_hops=0
while [ -L "$launcher_source" ] && [ "$launcher_hops" -lt 32 ]; do
    launcher_link=$(readlink "$launcher_source")
    case "$launcher_link" in
        /*) launcher_source="$launcher_link" ;;
        *)  launcher_source="$(dirname "$launcher_source")/$launcher_link" ;;
    esac
    launcher_hops=$((launcher_hops + 1))
done
LAUNCHER_BIN_DIR=$(cd -P "$(dirname "$launcher_source")" && pwd -P)
SELF_PATH="$LAUNCHER_BIN_DIR/$(basename "$launcher_source")"
THRONE_ROOT=$(cd -P "$LAUNCHER_BIN_DIR/.." && pwd -P)

. "$LAUNCHER_BIN_DIR/launcher-bash-guard.sh" || exit 1
throne_launcher_require_modern_bash "$SELF_PATH" "$@"

. "$LAUNCHER_BIN_DIR/agent-launcher-lib.sh" || exit 1

export CLAUDE_CODE_DISABLE_AUTO_MEMORY=0

claude_bin=""
if ! yolo_resolve_real_bin claude_bin claude "${CLAUDE_BIN:-}" "$SELF_PATH"; then
    echo "claudey: no real 'claude' binary found on PATH (searched everything except $YOLO_OVERRIDE_DIR)" >&2
    exit 127
fi

repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
backup_msg=""
claudey_setup_backup backup_msg "$repo_root"

add_dir_args=()
claudey_build_add_dir_args add_dir_args "$repo_root" "$THRONE_ROOT"

exec "$claude_bin" --allow-dangerously-skip-permissions --dangerously-skip-permissions "${add_dir_args[@]}" --append-system-prompt "$backup_msg" "$@"

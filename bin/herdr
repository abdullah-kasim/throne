#!/usr/bin/env bash
set -euo pipefail

shim_dir=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)

pinned=""
if [ -n "${THRONE_HERDR_CLIENT_PATH:-}" ]; then
    pinned="$THRONE_HERDR_CLIENT_PATH"
else
    data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
    pinned_root="$data_home/throne/herdr"
    if [ -d "$pinned_root" ]; then
        pinned=$(ls -d "$pinned_root"/v*/herdr 2>/dev/null | sort -V | tail -n 1 || true)
    fi
fi

if [ -n "$pinned" ] && [ -x "$pinned" ]; then
    exec "$pinned" "$@"
fi

real_herdr=""
IFS=: read -r -a search_path <<<"${PATH:-}"
for path_dir in "${search_path[@]}"; do
    [ -n "$path_dir" ] || path_dir=.
    candidate="$path_dir/herdr"
    [ -x "$candidate" ] || continue
    [ "$(cd -P "$(dirname "$candidate")" && pwd -P)/herdr" = "$shim_dir/herdr" ] && continue
    real_herdr="$candidate"
    break
done

if [ -z "$real_herdr" ]; then
    echo "throne herdr shim: no pinned herdr client under ${XDG_DATA_HOME:-$HOME/.local/share}/throne/herdr and no herdr on PATH" >&2
    exit 127
fi

exec "$real_herdr" "$@"

#!/usr/bin/env bash
#
# claude — Claude Code in yolo mode, on the throne's own pinned binary.
#
# `./bin/claude` is the entrypoint a human types. It pins the real binary to
# the vendored install (./vendor/node_modules/.bin/claude, version fixed by
# vendor-pins.json) and hands off to `claudey`, which does the actual yolo
# work: skip permission prompts, checkpoint the repo to a local bare backup,
# and wire the skill directories in via --add-dir.
#
# Why a separate file instead of symlinking claude -> claudey: the launcher
# resolves the REAL binary by scanning PATH for its own name, so a wrapper
# named `claude` sitting on PATH is exactly what it must not pick. Setting
# CLAUDE_BIN here removes the guesswork — the throne's pin always wins, and no
# globally installed Claude Code can shadow it.
#
# Every argument is forwarded untouched.

set -euo pipefail

# Resolve this script's directory through symlinks without `readlink -f`,
# which stock macOS does not have.
launcher_source="${BASH_SOURCE[0]}"
launcher_hops=0
while [ -L "$launcher_source" ] && [ "$launcher_hops" -lt 32 ]; do
    launcher_link=$(readlink "$launcher_source")
    case "$launcher_link" in
        /*) launcher_source="$launcher_link" ;;
        *)  launcher_source="$(dirname "$launcher_source")/$launcher_link" ;;
    esac
    launcher_hops=$((launcher_hops + 1))
done
LAUNCHER_BIN_DIR=$(cd -- "$(dirname -- "$launcher_source")" && pwd -P)
THRONE_ROOT=$(cd -- "$LAUNCHER_BIN_DIR/.." && pwd -P)

VENDORED_CLAUDE="$THRONE_ROOT/vendor/node_modules/.bin/claude"

if [ ! -x "$VENDORED_CLAUDE" ]; then
    cat >&2 <<EOF
bin/claude: no vendored Claude Code at
  $VENDORED_CLAUDE

The throne installs its own pinned harness rather than borrowing a global one.
Run the installer first:

  cd "$THRONE_ROOT" && ./install.sh

EOF
    exit 127
fi

# claudey honours \$CLAUDE_BIN as the real-binary override, and refuses any
# override that would resolve back into a wrapper. An absolute vendored path
# can never do that.
export CLAUDE_BIN="$VENDORED_CLAUDE"

exec "$LAUNCHER_BIN_DIR/claudey" "$@"

#!/usr/bin/env bash
# throne-gh-guard-shim — this marker identifies the guard to ITSELF; see below.
set -euo pipefail

guard_marker=throne-gh-guard-shim
guarded_command=${THRONE_GUARDED_COMMAND:-gh}
shim_dir=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
real_gh=""
IFS=: read -r -a search_path <<<"${PATH:-}"
first_unguarded_gh=""
for path_dir in "${search_path[@]}"; do
    [ -n "$path_dir" ] || path_dir=.
    [ -f "$path_dir/$guarded_command" ] && [ -x "$path_dir/$guarded_command" ] || continue
    if [ "$(cd -P "$path_dir" 2>/dev/null && pwd -P)" = "$shim_dir" ]; then
        real_gh=""
        continue
    fi
    [ -n "$real_gh" ] || real_gh="$path_dir/$guarded_command"
    [ -n "$first_unguarded_gh" ] || grep -Iqs -e "$guard_marker" -e 'throne gh guard' -- "$path_dir/$guarded_command" || first_unguarded_gh="$path_dir/$guarded_command"
done
[ -n "$real_gh" ] || real_gh="$first_unguarded_gh"

if [ -z "$real_gh" ]; then
    echo "throne gh guard: real $guarded_command binary not found" >&2
    exit 127
fi

attribution_fence_pattern='co-authored-by:.*(claude|anthropic|copilot|chatgpt|openai|gpt|codex|gemini|cursor)|generated[[:space:]]+with.{0,6}claude|noreply@anthropic\.com'

text_carries_ai_attribution() {
    local verdict=0
    printf '%s' "$1" | grep -Eiq -- "$attribution_fence_pattern" || verdict=$?
    if [ "$verdict" -gt 1 ]; then
        echo "throne attribution fence: the pattern check itself failed; refusing rather than letting the text through" >&2
        return 0
    fi
    return "$verdict"
}

refuse_ai_attribution() {
    local tool="$1"
    local offending_line
    offending_line=$(printf '%s' "$2" | grep -Eio -- "$attribution_fence_pattern" | head -1)
    echo "throne $tool guard: STOP — this text carries an AI attribution line ($offending_line)." >&2
    echo "Commit messages, PR bodies, comments and titles never credit an AI tool: no Co-Authored-By for Claude or any other model, no 'Generated with Claude Code', no noreply@anthropic.com." >&2
    echo "Remove the line and run the command again. There is no bypass for this check." >&2
}
fenced_args=("$@")
fenced_text=""
read_fenced_file() {
    local source="$1" position="$2" prefix="${3:-}"
    if [ "$source" = - ]; then
        local stdin_copy
        stdin_copy=$(mktemp "${TMPDIR:-/tmp}/throne-gh-body.XXXXXX")
        cat >"$stdin_copy"
        fenced_args[$position]="$prefix$stdin_copy"
        fenced_text+="$(<"$stdin_copy")"$'\n'
    elif [ -f "$source" ]; then
        fenced_text+="$(<"$source")"$'\n'
    fi
}
for ((fence_i = 0; fence_i < ${#fenced_args[@]}; fence_i++)); do
    fence_arg="${fenced_args[fence_i]}"
    fenced_text+="$fence_arg"$'\n'
    case "$fence_arg" in
        --body-file|--input)
            ((fence_i++))
            read_fenced_file "${fenced_args[fence_i]:-}" "$fence_i"
            ;;
        --body-file=*|--input=*)
            read_fenced_file "${fence_arg#*=}" "$fence_i" "${fence_arg%%=*}="
            ;;
        -F)
            ((fence_i++))
            fence_value="${fenced_args[fence_i]:-}"
            fenced_text+="$fence_value"$'\n'
            case "$fence_value" in
                *=@*) read_fenced_file "${fence_value#*=@}" "$fence_i" "${fence_value%%=@*}=@" ;;
                *=*) ;;
                *) read_fenced_file "$fence_value" "$fence_i" ;;
            esac
            ;;
        *=@*)
            read_fenced_file "${fence_arg#*=@}" "$fence_i" "${fence_arg%%=@*}=@"
            ;;
    esac
done
if text_carries_ai_attribution "$fenced_text"; then
    refuse_ai_attribution gh "$fenced_text"
    exit 67
fi
set -- "${fenced_args[@]}"

if [ "${THRONE_GH_GUARD_WAIVED:-}" = 1 ]; then
    echo "throne gh guard: BYPASSED by an outer guard's --bypass: $guarded_command $*" >&2
    exec "$real_gh" "$@"
fi

# An explicit `--bypass` as the FIRST argument waives the guard for this one
# invocation and is stripped before the real binary sees it. Position matters:
# scanning the whole argv would let the literal string "--bypass" inside a PR
# body, issue title or --jq expression silently unlock a mutation.
if [ "${1:-}" = "--bypass" ]; then
    shift
    echo "throne gh guard: BYPASSED by explicit --bypass: $guarded_command $*" >&2
    THRONE_GH_GUARD_WAIVED=1 exec "$real_gh" "$@"
fi

command_name=${1:-help}
subcommand=${2:-}
allowed=false

case "$command_name" in
    --help|-h|--version|help|status|completion)
        allowed=true
        ;;
    auth)
        [ "$subcommand" = status ] && allowed=true
        ;;
    api)
        # `gh api <path>` defaults to GET; only the method actually decides
        # mutation vs. read, and `-X`/`--method` can appear anywhere in the
        # remaining argv (after the endpoint, combined as `-XPOST`, etc.) —
        # so scan every remaining word rather than trusting position 2.
        api_method=GET
        api_args=("${@:2}")
        api_i=0
        while [ "$api_i" -lt "${#api_args[@]}" ]; do
            api_arg=${api_args[$api_i]}
            case "$api_arg" in
                -X|--method)
                    api_i=$((api_i + 1))
                    api_method=${api_args[$api_i]:-GET}
                    ;;
                -X*)
                    api_method=${api_arg#-X}
                    ;;
                --method=*)
                    api_method=${api_arg#--method=}
                    ;;
            esac
            api_i=$((api_i + 1))
        done
        case "${api_method^^}" in
            GET|HEAD) allowed=true ;;
        esac
        ;;
    search)
        allowed=true
        ;;
    issue)
        case "$subcommand" in list|view|status) allowed=true ;; esac
        ;;
    pr)
        case "$subcommand" in list|view|diff|checks|status) allowed=true ;; esac
        ;;
    repo)
        case "$subcommand" in list|view|clone) allowed=true ;; esac
        ;;
    run)
        case "$subcommand" in list|view|watch|download) allowed=true ;; esac
        ;;
    workflow)
        case "$subcommand" in list|view) allowed=true ;; esac
        ;;
    release)
        case "$subcommand" in list|view|download) allowed=true ;; esac
        ;;
    label)
        [ "$subcommand" = list ] && allowed=true
        ;;
    secret)
        [ "$subcommand" = list ] && allowed=true
        ;;
    variable)
        case "$subcommand" in list|get) allowed=true ;; esac
        ;;
    cache)
        case "$subcommand" in list) allowed=true ;; esac
        ;;
esac

if [ "$allowed" != true ]; then
    echo "throne gh guard: denied GitHub mutation or unclassified command: $guarded_command $*" >&2
    echo "throne agents may inspect GitHub but may not mutate external GitHub state" >&2
    exit 64
fi

exec "$real_gh" "$@"

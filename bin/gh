#!/usr/bin/env bash
# throne-gh-guard-shim — this marker identifies the guard to ITSELF; see below.
set -euo pipefail

guard_marker=throne-gh-guard-shim
guarded_command=${THRONE_GUARDED_COMMAND:-gh}
shim_dir=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
real_gh=""
IFS=: read -r -a search_path <<<"${PATH:-}"
first_unguarded_gh=""
for path_dir in "${search_path[@]}"; do
    [ -n "$path_dir" ] || path_dir=.
    [ -f "$path_dir/$guarded_command" ] && [ -x "$path_dir/$guarded_command" ] || continue
    if [ "$(cd -P "$path_dir" 2>/dev/null && pwd -P)" = "$shim_dir" ]; then
        real_gh=""
        continue
    fi
    [ -n "$real_gh" ] || real_gh="$path_dir/$guarded_command"
    [ -n "$first_unguarded_gh" ] || grep -Iqs -e "$guard_marker" -e 'throne gh guard' -- "$path_dir/$guarded_command" || first_unguarded_gh="$path_dir/$guarded_command"
done
[ -n "$real_gh" ] || real_gh="$first_unguarded_gh"

if [ -z "$real_gh" ]; then
    echo "throne gh guard: real $guarded_command binary not found" >&2
    exit 127
fi

attribution_fence_pattern='co-authored-by:.*(claude|anthropic|copilot|chatgpt|openai|gpt|codex|gemini|cursor)|generated[[:space:]]+with.{0,6}claude|noreply@anthropic\.com'

text_carries_ai_attribution() {
    local verdict=0
    printf '%s' "$1" | grep -Eiq -- "$attribution_fence_pattern" || verdict=$?
    if [ "$verdict" -gt 1 ]; then
        echo "throne attribution fence: the pattern check itself failed; refusing rather than letting the text through" >&2
        return 0
    fi
    return "$verdict"
}

refuse_ai_attribution() {
    local tool="$1"
    local offending_line
    offending_line=$(printf '%s' "$2" | grep -Eio -- "$attribution_fence_pattern" | head -1)
    echo "throne $tool guard: STOP — this text carries an AI attribution line ($offending_line)." >&2
    echo "Commit messages, PR bodies, comments and titles never credit an AI tool: no Co-Authored-By for Claude or any other model, no 'Generated with Claude Code', no noreply@anthropic.com." >&2
    echo "Remove the line and run the command again. There is no bypass for this check." >&2
}
fenced_args=("$@")
fenced_text=""
read_fenced_file() {
    local source="$1" position="$2" prefix="${3:-}"
    if [ "$source" = - ]; then
        local stdin_copy
        stdin_copy=$(mktemp "${TMPDIR:-/tmp}/throne-gh-body.XXXXXX")
        cat >"$stdin_copy"
        fenced_args[$position]="$prefix$stdin_copy"
        fenced_text+="$(<"$stdin_copy")"$'\n'
    elif [ -f "$source" ]; then
        fenced_text+="$(<"$source")"$'\n'
    fi
}
for ((fence_i = 0; fence_i < ${#fenced_args[@]}; fence_i++)); do
    fence_arg="${fenced_args[fence_i]}"
    fenced_text+="$fence_arg"$'\n'
    case "$fence_arg" in
        --body-file|--input)
            ((fence_i++))
            read_fenced_file "${fenced_args[fence_i]:-}" "$fence_i"
            ;;
        --body-file=*|--input=*)
            read_fenced_file "${fence_arg#*=}" "$fence_i" "${fence_arg%%=*}="
            ;;
        -F)
            ((fence_i++))
            fence_value="${fenced_args[fence_i]:-}"
            fenced_text+="$fence_value"$'\n'
            case "$fence_value" in
                *=@*) read_fenced_file "${fence_value#*=@}" "$fence_i" "${fence_value%%=@*}=@" ;;
                *=*) ;;
                *) read_fenced_file "$fence_value" "$fence_i" ;;
            esac
            ;;
        *=@*)
            read_fenced_file "${fence_arg#*=@}" "$fence_i" "${fence_arg%%=@*}=@"
            ;;
    esac
done
if text_carries_ai_attribution "$fenced_text"; then
    refuse_ai_attribution gh "$fenced_text"
    exit 67
fi
set -- "${fenced_args[@]}"

json_string_or_null() {
    local value backslash='\' quote='"'
    value=$(printf '%s' "$1" | tr -d '\000-\037')
    if [ -z "$value" ]; then
        printf null
        return
    fi
    value=${value//"$backslash"/"$backslash$backslash"}
    value=${value//"$quote"/"$backslash$quote"}
    printf '"%s"' "$value"
}

flag_takes_content() {
    case "$1" in
        --body|-b|--body-file|--title|-t|--subject|--message|-m|--notes|-n|--notes-file|--field|-f|--raw-field|-F|--input|--header|-H|--jq|-q|--template) return 0 ;;
    esac
    return 1
}

subcommand_with_flag_names() {
    local words=$1 argument flag_name skip_next=false
    shift
    if [ "$words" != api ] && [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
        words="$words $1"
        shift
    fi
    for argument in "$@"; do
        if [ "$skip_next" = true ]; then
            skip_next=false
            continue
        fi
        case "$argument" in
            --) break ;;
            --[A-Za-z]*) flag_name=${argument%%=*} ;;
            -[A-Za-z]*) flag_name=${argument:0:2} ;;
            *) continue ;;
        esac
        case "${flag_name#--}" in *[!A-Za-z0-9-]*) continue ;; esac
        words="$words $flag_name"
        if [ "$flag_name" = "$argument" ] && flag_takes_content "$flag_name"; then
            skip_next=true
        fi
    done
    printf '%s' "$words"
}

remember_pull_request_number() {
    local kind=$1 number=${2%%[#?]*}
    case "$kind" in pull|pulls|issues) ;; *) return 0 ;; esac
    case "$number" in ''|*[!0-9]*) return 0 ;; esac
    [ -n "$target_pull_request" ] || target_pull_request=$((10#$number))
}

remember_repository_reference() {
    local reference=${1#*://} segments host
    IFS=/ read -r -a segments <<<"$reference"
    case "${#segments[@]}" in
        0|1) return 0 ;;
        2)
            [ -n "$target_repo" ] || target_repo="${segments[0]}/${segments[1]%.git}"
            ;;
        *)
            host=${segments[0]##*@}
            [ -n "$target_host" ] || target_host=${host%%:*}
            [ -n "$target_repo" ] || target_repo="${segments[1]}/${segments[2]%.git}"
            remember_pull_request_number "${segments[3]:-}" "${segments[4]:-}"
            ;;
    esac
}

remember_api_url_host() {
    local address=${1#*://}
    [ -n "$target_host" ] || target_host=${address%%/*}
}

remember_api_endpoint() {
    local argument endpoint segments
    for argument in "$@"; do
        case "$argument" in
            http://*/repos/*/*|https://*/repos/*/*)
                remember_api_url_host "$argument"
                argument=repos/${argument#*/repos/}
                ;;
        esac
        case "$argument" in
            repos/*/*|/repos/*/*)
                endpoint=${argument#/}
                IFS=/ read -r -a segments <<<"${endpoint%%[?]*}"
                [ -n "$target_repo" ] || target_repo="${segments[1]}/${segments[2]}"
                remember_pull_request_number "${segments[3]:-}" "${segments[4]:-}"
                return 0
                ;;
        esac
    done
}

remember_target_argument() {
    local command_name=$1 target=$2
    case "$target" in
        *://*) remember_repository_reference "$target" ;;
        *)
            [ "$command_name" = pr ] || return 0
            target=${target#\#}
            case "$target" in ''|*[!0-9]*) ;; *) target_pull_request=$((10#$target)) ;; esac
            ;;
    esac
}

remember_origin_remote() {
    local remote slash=/
    remote=$(git config --get remote.origin.url 2>/dev/null) || return 0
    case "$remote" in
        *://*) ;;
        *:*) remote=${remote/:/$slash} ;;
    esac
    remember_repository_reference "$remote"
}

gh_default_host=github.com

host_pinned_by_real_binary() {
    local assignment
    assignment=$(grep -IEo -m1 "GH_HOST=[\"']?[A-Za-z0-9.-]+" -- "$real_gh" 2>/dev/null | head -1) || return 0
    assignment=${assignment#GH_HOST=}
    printf '%s' "${assignment#[\"\']}"
}

derive_github_target() {
    local command_name=${1:-} previous="" argument hostname=""
    target_host="" target_repo="" target_pull_request=""
    for argument in "$@"; do
        case "$previous" in
            -R|--repo) remember_repository_reference "$argument" ;;
            --hostname) hostname=$argument ;;
        esac
        case "$argument" in
            --repo=*) remember_repository_reference "${argument#--repo=}" ;;
            -R?*) remember_repository_reference "${argument#-R}" ;;
            --hostname=*) hostname=${argument#--hostname=} ;;
        esac
        previous=$argument
    done
    if [ "$command_name" = api ]; then
        remember_api_endpoint "${@:2}"
    elif [ $# -ge 3 ]; then
        remember_target_argument "$command_name" "$3"
    fi
    [ -n "$target_host" ] || target_host=$hostname
    [ -n "$target_host" ] || target_host=${GH_HOST:-}
    [ -n "$target_host" ] || target_host=$(host_pinned_by_real_binary)
    [ -n "$target_host" ] && [ -n "$target_repo" ] || remember_origin_remote
    [ -n "$target_host" ] || [ "$guarded_command" != gh ] || target_host=$gh_default_host
}

github_action_json_line() {
    local exit_code=$1
    shift
    derive_github_target "$@"
    printf '{"timestamp":"%s","agent":%s,"host":%s,"repo":%s,"subcommand":%s,"pr":%s,"exit_code":%s}' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "$(json_string_or_null "${THRONE_AGENT_NAME:-}")" \
        "$(json_string_or_null "$target_host")" \
        "$(json_string_or_null "$target_repo")" \
        "$(json_string_or_null "$(subcommand_with_flag_names "$@")")" \
        "${target_pull_request:-null}" \
        "$exit_code"
}

github_action_log_file() {
    local data_home=${THRONE_DATA_HOME:-$HOME/.throne}
    case "$data_home" in
        /*) printf '%s/data/github-actions.jsonl' "$data_home" ;;
        *) return 1 ;;
    esac
}

record_github_action() {
    local log_file line
    log_file=$(github_action_log_file) &&
        line=$(github_action_json_line "$@") &&
        { mkdir -p "${log_file%/*}" && printf '%s\n' "$line" >>"$log_file"; } 2>/dev/null ||
        echo "throne gh guard: the GitHub action log could not be written: ${log_file:-THRONE_DATA_HOME is not an absolute path}" >&2
}

bypass_source=none
if [ "${THRONE_GH_GUARD_WAIVED:-}" = 1 ]; then
    bypass_source=outer_guard
    echo "throne gh guard: BYPASSED by an outer guard's --bypass: $guarded_command $*" >&2
fi

# An explicit `--bypass` as the FIRST argument waives the guard for this one
# invocation and is stripped before the real binary sees it. Position matters:
# scanning the whole argv would let the literal string "--bypass" inside a PR
# body, issue title or --jq expression silently unlock a mutation.
if [ "$bypass_source" = none ] && [ "${1:-}" = "--bypass" ]; then
    shift
    bypass_source=explicit
    echo "throne gh guard: BYPASSED by explicit --bypass: $guarded_command $*" >&2
    export THRONE_GH_GUARD_WAIVED=1
fi

command_name=${1:-help}
subcommand=${2:-}
allowed=false

case "$command_name" in
    --help|-h|--version|help|status|completion)
        allowed=true
        ;;
    auth)
        [ "$subcommand" = status ] && allowed=true
        ;;
    api)
        # `gh api <path>` defaults to GET; only the method actually decides
        # mutation vs. read, and `-X`/`--method` can appear anywhere in the
        # remaining argv (after the endpoint, combined as `-XPOST`, etc.) —
        # so scan every remaining word rather than trusting position 2.
        api_method=GET
        api_args=("${@:2}")
        api_i=0
        while [ "$api_i" -lt "${#api_args[@]}" ]; do
            api_arg=${api_args[$api_i]}
            case "$api_arg" in
                -X|--method)
                    api_i=$((api_i + 1))
                    api_method=${api_args[$api_i]:-GET}
                    ;;
                -X*)
                    api_method=${api_arg#-X}
                    ;;
                --method=*)
                    api_method=${api_arg#--method=}
                    ;;
            esac
            api_i=$((api_i + 1))
        done
        case "$(printf '%s' "$api_method" | tr '[:lower:]' '[:upper:]')" in
            GET|HEAD) allowed=true ;;
        esac
        ;;
    search)
        allowed=true
        ;;
    issue)
        case "$subcommand" in list|view|status) allowed=true ;; esac
        ;;
    pr)
        case "$subcommand" in list|view|diff|checks|status) allowed=true ;; esac
        ;;
    repo)
        case "$subcommand" in list|view|clone) allowed=true ;; esac
        ;;
    run)
        case "$subcommand" in list|view|watch|download) allowed=true ;; esac
        ;;
    workflow)
        case "$subcommand" in list|view) allowed=true ;; esac
        ;;
    release)
        case "$subcommand" in list|view|download) allowed=true ;; esac
        ;;
    label)
        [ "$subcommand" = list ] && allowed=true
        ;;
    secret)
        [ "$subcommand" = list ] && allowed=true
        ;;
    variable)
        case "$subcommand" in list|get) allowed=true ;; esac
        ;;
    cache)
        case "$subcommand" in list) allowed=true ;; esac
        ;;
esac

if [ "$allowed" = true ]; then
    exec "$real_gh" "$@"
fi

if [ "$bypass_source" = none ]; then
    echo "throne gh guard: denied GitHub mutation or unclassified command: $guarded_command $*" >&2
    echo "throne agents may inspect GitHub but may not mutate external GitHub state" >&2
    exit 64
fi

if [ "${THRONE_GH_OUTER_GUARD_LOGS:-}" = 1 ]; then
    exec "$real_gh" "$@"
fi

mutation_exit_code=0
THRONE_GH_OUTER_GUARD_LOGS=1 "$real_gh" "$@" || mutation_exit_code=$?
record_github_action "$mutation_exit_code" "$@" || true
exit "$mutation_exit_code"
